# Copy to .env and fill your own key. Never share .env.
# Clicking Analyze sends the displayed evidence summary to DeepSeek.
WORKBENCH_LLM_BASE_URL=https://api.deepseek.com
WORKBENCH_LLM_MODEL=deepseek-v4-flash
WORKBENCH_LLM_API_KEY=
# Local alternative: http://127.0.0.1:11434/v1 with an installed local model.
