APP_ENV=local
LOG_LEVEL=INFO
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_OUTPUT_DIR=data/output
SCREENSHOT_DIR=data/screenshots
SQLITE_PATH=data/processed/ecom_ops.sqlite3
SELECTORS_PATH=config/selectors.yaml
INTEGRATIONS_PATH=config/integrations.yaml
BROWSER_HEADLESS=true
AUTOMATION_ENABLED=false
REQUIRE_HUMAN_CONFIRMATION=true
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_SERVER_PORT=8501

# TikTok Login Kit / Display API
# Create an app at https://developers.tiktok.com/ and enable Login Kit + Display API.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://127.0.0.1:8000/tiktok/oauth/callback
TIKTOK_LOGIN_PLATFORM=desktop
TIKTOK_SCOPES=user.info.basic,video.list
TIKTOK_SYNC_INTERVAL_SECONDS=300
TIKTOK_MAX_PAGES_PER_SYNC=50
TIKTOK_REQUEST_TIMEOUT_SECONDS=20

# TikTok API for Business (read-only reporting)
# Create/authorize an app in TikTok Business Center. Never commit the access token.
TIKTOK_BUSINESS_ACCESS_TOKEN=
TIKTOK_BUSINESS_ADVERTISER_ID=
TIKTOK_BUSINESS_BASE_URL=https://business-api.tiktok.com/open_api/v1.3
TIKTOK_ADS_REPORT_DAYS=30
TIKTOK_ADS_METRICS=spend,impressions,clicks,ctr,cpc,conversion,cost_per_conversion,video_play_actions,video_watched_2s,video_watched_6s,video_views_p100,onsite_total_purchase,onsite_purchases_roas

# Mature external platforms (kept as isolated services)
POSTIZ_URL=http://127.0.0.1:4200
BRIGHTBEAN_URL=http://127.0.0.1:8001
MULTICA_URL=http://127.0.0.1:3000
EXTERNAL_HEALTH_TIMEOUT_SECONDS=3

# Automatic video mixer (cloud calls are disabled until OPENAI_API_KEY is set)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MIXER_VISION_MODEL=gpt-5-mini
MIXER_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
MIXER_TTS_MODEL=gpt-4o-mini-tts
MIXER_TTS_VOICE=marin
# 0 means each paid batch requires explicit confirmation in the workbench.
MIXER_DAILY_BUDGET=0
MIXER_DOWNLOAD_CONCURRENCY=2
MIXER_RENDER_CONCURRENCY=1
# Unofficial parser is opt-in and always remains the last fallback.
MIXER_USE_TIKWM_FALLBACK=false
MIXER_COOKIES_FILE=
MIXER_COOKIES_FROM_BROWSER=
